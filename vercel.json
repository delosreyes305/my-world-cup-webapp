{
  "rewrites": [
    {
      "source": "/api/football/:path*",
      "destination": "https://v3.football.api-sports.io/:path*"
    },
    {
      "source": "/api/news",
      "destination": "https://api.thenewsapi.com/v1/news/all"
    },
    {
      "source": "/api/auth/:path*",
      "destination": "https://my-world-cup-webapp-production.up.railway.app/api/auth/:path*"
    },
    {
      "source": "/api/favorites/:path*",
      "destination": "https://my-world-cup-webapp-production.up.railway.app/api/favorites/:path*"
    },
    {
      "source": "/api/notifications/:path*",
      "destination": "https://my-world-cup-webapp-production.up.railway.app/api/notifications/:path*"
    },
    {
      "source": "/(.*)",
      "destination": "/index.html"
    }
  ]
}
